# PostgreSQL Connection Configuration
# Update these if your PostgreSQL is installed with different credentials or port

# JDBC URL for PostgreSQL
# Format: jdbc:postgresql://host:port/database
# Default is localhost on port 5432
DB_URL=jdbc:postgresql://localhost:5432/document_ai

# PostgreSQL username
# Default user created during PostgreSQL installation is 'postgres'
DB_USERNAME=postgres

# PostgreSQL password
# Set during PostgreSQL installation
DB_PASSWORD=postgres

# Hibernate DDL Auto Strategy
# Options:
#   - create-drop: Drop schema and recreate on startup (DEV ONLY)
#   - create: Create schema on startup if not exists
#   - update: Update existing schema (RECOMMENDED for PROD)
#   - validate: Just validate existing schema
DDL_AUTO=create-drop

# Show SQL queries in logs (helpful for debugging)
# Options: true, false
SHOW_SQL=false

# Spring Profiles Active
# Options: dev, staging, prod
SPRING_PROFILES_ACTIVE=dev

# Application Configuration
# Server port where backend runs
SERVER_PORT=8080

# Maximum file upload size (in bytes)
# 10485760 = 10 MB (default)
MAX_FILE_SIZE=10485760

# Max request size (usually same as max file size)
MAX_REQUEST_SIZE=10485760

# Logging Levels
# Options: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL_SPRING=INFO
LOG_LEVEL_HIBERNATE=DEBUG
LOG_LEVEL_SQL=TRACE

# Connection Pool Settings
DB_CONNECTION_POOL_SIZE=10
DB_MIN_IDLE=5
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# Hibernate Performance Settings
HIBERNATE_BATCH_SIZE=20
HIBERNATE_FETCH_SIZE=50

# Frontend API URL (if different from default http://localhost:8080)
# Used by React frontend to connect to backend
VITE_API_URL=http://localhost:8080
